# Copy these into Vercel's Project Settings -> Environment Variables.
# Never commit a real .env file with actual secrets to git.

JIRA_BASE_URL=https://zeta-tm.atlassian.net
JIRA_EMAIL=your-email@company.com
JIRA_API_TOKEN=your-api-token-here

# Optional overrides (defaults shown)
JIRA_BOARD_ID=5839
JIRA_PROJECT_KEY=EON
JIRA_HYGIENE_LABELS=LE_Bank_Requirement,Add_On_Bank_requirement

# Optional — sprint working-day math (Mon-Fri) uses this timezone. Default: Asia/Kolkata.
# TEAM_TIMEZONE=Asia/Kolkata

# Optional — restricts DELETING a program (Manage Programs page) to these
# emails only. Comma-separated, case-insensitive. Adding and editing a
# program stay open to any signed-in user either way. Leave unset and any
# signed-in user can delete too — same zero-config default as everything else.
# ADMIN_EMAILS=you@company.com,teammate@company.com

# Lock this down to your actual dashboard's origin once deployed, e.g.
# https://your-dashboards.vercel.app  (comma-separate multiple if needed)
# Leave as * only for initial local testing.
ALLOWED_ORIGIN=*

# --- Login with Atlassian (required for the auth-gated dashboards) ---
# Register an OAuth 2.0 (3LO) app at https://developer.atlassian.com/console/myapps/
ATLASSIAN_CLIENT_ID=your-client-id
ATLASSIAN_CLIENT_SECRET=your-client-secret

# The exact deployed URL of THIS project (no trailing slash), e.g.
# https://eon-jira-dashboards.vercel.app
PUBLIC_URL=https://your-deployment.vercel.app

# A long random string used to sign session cookies. Generate one with:
# openssl rand -hex 32   (or any random 32+ character string)
SESSION_SECRET=change-this-to-a-long-random-string

# Optional: only allow sign-ins from this email domain (recommended).
# Leave unset to allow any Atlassian account to log in.
ALLOWED_EMAIL_DOMAIN=zeta.tech

# --- AI executive summary (optional feature) ---
# Get a key at https://console.anthropic.com — this is billed separately from
# your Claude.ai subscription, based on actual API usage.
ANTHROPIC_API_KEY=your-anthropic-api-key
# Optional override; defaults to claude-sonnet-4-5 if unset.
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Added programs storage ---
# Not set by hand. In Vercel: Project > Storage > create a Blob store and connect it
# to the project. Vercel then adds BLOB_READ_WRITE_TOKEN automatically. Programs
# created in the Add Program page live there (EON itself comes from the variables above).
